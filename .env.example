# easy-peasy-logo — miljövariabler (exempel)
# Kopiera till .env.local och fyll i riktiga värden. Committas ALDRIG.

# ---- Frontend (VITE_ exponeras till klienten) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLIC_KEY=

# ---- Server ----
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI ----
XAI_API_KEY=
KIEAI_API_KEY=

# ---- Chatt-minne (Upstash Redis REST) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
